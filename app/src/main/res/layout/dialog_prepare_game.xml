<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_obb"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="22dp">

    <FrameLayout
        android:layout_width="86dp"
        android:layout_height="86dp">

        <ProgressBar
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminateTint="#10B7FF" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_prepare_module_icon"
            android:contentDescription="Preparing module"
            android:padding="12dp"
            android:src="@drawable/ic_cube_3d"
            app:tint="#65B6FF" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preparing game"
            android:textColor="#F7F9FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_prepare_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Downloading and verifying module..."
            android:textColor="#9DB2D5"
            android:textSize="14sp" />

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            android:indeterminateTint="#08BFFF"
            android:progressBackgroundTint="#1B3154" />
    </LinearLayout>
</LinearLayout>
