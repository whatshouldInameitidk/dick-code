<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_obb"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="22dp"
    android:paddingBottom="22dp">

    <!-- Header Row: Glowing Icon + Title + Status + Accent Line -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Glowing Cube Container -->
        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_icon_cube_glow">

            <ImageView
                android:id="@+id/ivDialogHeaderIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_neon_cube"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <!-- Title & Subtitle + Accent Line -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Game Data (OBB)"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDialogSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Detected"
                android:textColor="#00A3FF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Segmented Accent Line -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/viewIndicatorCyan"
                    android:layout_width="32dp"
                    android:layout_height="2.5dp"
                    android:background="@drawable/bg_indicator_cyan" />

                <View
                    android:id="@+id/viewIndicatorBlue"
                    android:layout_width="14dp"
                    android:layout_height="2.5dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_indicator_blue" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="4dp"
                    android:background="#15263D" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- File Info Card -->
    <LinearLayout
        android:id="@+id/cardFileInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_card_obb_file"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp">

        <!-- File Icon Frame -->
        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_doc_frame">

            <ImageView
                android:id="@+id/ivFileIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_document_file"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <!-- File Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFileCardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="FOUND OBB GAME FILE:"
                android:textColor="#62768E"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="main.21535.com.pubg.imobile.obb"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFileSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="(1.1 GB)"
                android:textColor="#8095AB"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Question Prompt Row with Quote Bar -->
    <LinearLayout
        android:id="@+id/layoutQuestionPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/viewQuoteBar"
            android:layout_width="3dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_quote_bar" />

        <TextView
            android:id="@+id/tvQuestionMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:lineSpacingExtra="3.5dp"
            android:text="Would you like to install it into
Inverness virtual space now?"
            android:textColor="#CBD5E1"
            android:textSize="13.5sp" />
    </LinearLayout>

    <!-- Interactive Progress Section (Hidden by default, shown during copy) -->
    <LinearLayout
        android:id="@+id/layoutProgressSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvProgressStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Installing OBB into virtual space..."
                android:textColor="#94A3B8"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tvProgressPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#00D2FF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pbObbProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_drawable_neon" />
    </LinearLayout>

    <!-- Buttons Container -->
    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <!-- Primary Action Button: Gradient Pill with Download Icon -->
        <LinearLayout
            android:id="@+id/btnPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_install_launch"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivPrimaryBtnIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_download_arrow"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvPrimaryBtnText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.04"
                android:text="INSTALL &amp; LAUNCH"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Secondary Bottom Row: Cancel + Select Another -->
        <LinearLayout
            android:id="@+id/layoutSecondaryButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Cancel Button -->
            <FrameLayout
                android:id="@+id/btnDialogCancel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_dialog_cancel"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvCancelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:letterSpacing="0.03"
                    android:text="CANCEL"
                    android:textColor="#94A3B8"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Secondary Action Button -->
            <FrameLayout
                android:id="@+id/btnDialogSecondary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_dialog_secondary"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvSecondaryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:letterSpacing="0.03"
                    android:text="SELECT ANOTHER"
                    android:textColor="#00A3FF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
