        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_setting_group" android:orientation="vertical" android:padding="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:gravity="center_vertical" android:orientation="horizontal"><ImageView android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_setting_icon_green" android:contentDescription="Xposed" android:padding="14dp" android:src="@drawable/ic_neon_cube" app:tint="#54E9AA" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Xposed Setting" android:textColor="#F7F9FF" android:textSize="20sp" android:textStyle="bold" /><ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="Expanded" android:rotation="180" android:src="@drawable/ic_chevron_down" app:tint="#9DB1D2" /></LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_setting_rows" android:orientation="vertical">
