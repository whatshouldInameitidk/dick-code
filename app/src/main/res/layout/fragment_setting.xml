                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#23334B" />
                <LinearLayout android:id="@+id/row_module_manager" android:layout_width="match_parent" android:layout_height="88dp" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"><ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_setting_action" android:contentDescription="Module manager" android:padding="13dp" android:src="@drawable/ic_document_file" app:tint="#64B1FF" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:text="Module Manager" android:textColor="#F7F9FF" android:textSize="18sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#9DB1D2" android:textSize="40sp" /></LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_setting_group" android:orientation="vertical" android:padding="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:gravity="center_vertical" android:orientation="horizontal"><ImageView android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_setting_icon_amber" android:contentDescription="Other settings" android:padding="14dp" android:src="@drawable/ic_nav_apps" app:tint="#FFC96B" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:text="Others" android:textColor="#F7F9FF" android:textSize="20sp" android:textStyle="bold" /><ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="Expanded" android:rotation="180" android:src="@drawable/ic_chevron_down" app:tint="#9DB1D2" /></LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_setting_rows" android:orientation="vertical">
                <LinearLayout android:id="@+id/row_gms_manager" android:layout_width="match_parent" android:layout_height="82dp" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"><ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_setting_action" android:contentDescription="GMS manager" android:padding="11dp" android:src="@drawable/ic_android_robot" app:tint="#64B1FF" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:text="GMS Manager" android:textColor="#F7F9FF" android:textSize="18sp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#9DB1D2" android:textSize="40sp" /></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#23334B" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"><ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_setting_action" android:contentDescription="Hide Xposed" android:padding="11dp" android:src="@drawable/ic_empty" app:tint="#FF849E" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:text="Hide Xposed" android:textColor="#F7F9FF" android:textSize="18sp" /><androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_hide_xposed" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="#F4F8FF" app:trackTint="@color/setting_switch_track" /></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#23334B" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"><ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_setting_action" android:contentDescription="Hide root" android:padding="11dp" android:src="@drawable/ic_neon_cube" app:tint="#55E9A5" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:text="Hide Root" android:textColor="#F7F9FF" android:textSize="18sp" /><androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_hide_root" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="#F4F8FF" app:trackTint="@color/setting_switch_track" /></LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#23334B" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="82dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp"><ImageView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_setting_action" android:contentDescription="Daemon" android:padding="11dp" android:src="@drawable/ic_nav_setting" app:tint="#A78BFF" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:text="Daemon" android:textColor="#F7F9FF" android:textSize="18sp" /><androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_daemon" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="#F4F8FF" app:trackTint="@color/setting_switch_track" /></LinearLayout>
            </LinearLayout>
        </LinearLayout>
