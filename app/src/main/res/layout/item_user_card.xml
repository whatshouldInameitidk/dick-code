<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="116dp" android:layout_marginBottom="14dp" android:background="@drawable/bg_user_card_inactive" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="18dp" android:paddingEnd="14dp">
    <ImageView android:id="@+id/iv_user_avatar" android:layout_width="76dp" android:layout_height="76dp" android:background="@drawable/bg_pill_user" android:contentDescription="Virtual user" android:padding="19dp" android:src="@drawable/ic_nav_users" app:tint="#8AB3FF" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_user_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F7F9FF" android:textSize="20sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <View android:id="@+id/v_user_status" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_user_status_dot" />
            <TextView android:id="@+id/tv_user_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="#91A8D3" android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/btn_switch_user" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_user_action" android:contentDescription="Switch user" android:padding="14dp" android:src="@drawable/ic_play_arrow" app:tint="#93B8FF" />
    <ImageView android:id="@+id/btn_rename_user" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:background="@drawable/bg_user_action" android:contentDescription="User options" android:padding="14dp" android:src="@drawable/ic_nav_setting" app:tint="#93B8FF" />
    <ImageView android:id="@+id/btn_delete_user" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
</LinearLayout>
