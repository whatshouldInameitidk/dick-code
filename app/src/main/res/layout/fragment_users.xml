<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/dark_bg" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="32dp" android:paddingEnd="20dp" android:paddingBottom="112dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Virtual Users" android:textColor="#F7F9FF" android:textSize="32sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Switch or create multi-account virtual spaces" android:textColor="#91A8D3" android:textSize="17sp" />
        <LinearLayout android:id="@+id/btn_create_user" android:layout_width="match_parent" android:layout_height="68dp" android:layout_marginTop="30dp" android:background="@drawable/bg_auth_button" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="Create new user" android:src="@drawable/ic_add" app:tint="#FFFFFF" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:text="Create New User" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_users" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:clipToPadding="false" android:nestedScrollingEnabled="false" android:overScrollMode="never" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_license_card" android:orientation="vertical" android:padding="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_license_icon" android:contentDescription="License security" android:padding="7dp" android:src="@drawable/ic_neon_cube" app:tint="#54B5FF" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="License Information" android:textColor="#F7F9FF" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_license_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_user_status_active" android:paddingStart="9dp" android:paddingTop="4dp" android:paddingEnd="9dp" android:paddingBottom="4dp" android:text="●  Active" android:textColor="#4BE29D" android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="12dp" android:background="@drawable/bg_license_metrics" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/tv_license_days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#69B7FF" android:textSize="21sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Days" android:textColor="#8FA5CA" android:textSize="9sp" /></LinearLayout>
                <View android:layout_width="1dp" android:layout_height="32dp" android:background="#26334A" />
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/tv_license_hours" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#69B7FF" android:textSize="21sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hours" android:textColor="#8FA5CA" android:textSize="9sp" /></LinearLayout>
                <View android:layout_width="1dp" android:layout_height="32dp" android:background="#26334A" />
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/tv_license_minutes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#69B7FF" android:textSize="21sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Minutes" android:textColor="#8FA5CA" android:textSize="9sp" /></LinearLayout>
                <View android:layout_width="1dp" android:layout_height="32dp" android:background="#26334A" />
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/tv_license_seconds" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#69B7FF" android:textSize="21sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Seconds" android:textColor="#8FA5CA" android:textSize="9sp" /></LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="Expiry date" android:padding="5dp" android:src="@drawable/ic_document_file" app:tint="#9AB3DD" />
                <TextView android:id="@+id/tv_license_expiry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#A9B9D5" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/btn_support" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_user_info_card" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:padding="20dp">
            <ImageView android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_user_action" android:contentDescription="Official Telegram channel" android:padding="10dp" android:src="@drawable/ic_telegram" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Official Telegram Channel" android:textColor="#F7F9FF" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="News • Updates • Support" android:textColor="#91A8D3" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
