<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Crash Reporting">

        <SwitchPreferenceCompat
                app:key="send_crash_report"
                app:icon="@drawable/ic_report"
                android:title="Send Crash Report"
                android:summary="Automatically send detailed crash logs to Telegram (@InvXCrashReporterBot) when BlackBox or any virtual app crashes"
                android:defaultValue="true"/>

        <Preference
                android:key="crash_report"
                android:title="Test &amp; Bot Status"
                android:summary="Verify @InvXCrashReporterBot connection or trigger test report"/>

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/xp_setting">

        <SwitchPreferenceCompat
                app:key="xp_enable"
                app:title="@string/enable_xposed" />

        <Preference
                android:dependency="xp_enable"
                app:key="xp_module"
                app:summary="@string/jump_module"
                app:title="@string/module_setting" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/other">

        <Preference
                android:key="gms_manager"
                android:title="@string/gms_manager"
                android:summary="@string/jump_gms"/>

        <SwitchPreferenceCompat
                app:key="xp_hide"
                app:title="@string/hide_xposed" />

        <SwitchPreferenceCompat
                app:key="root_hide"
                app:title="@string/hide_root" />

        <SwitchPreferenceCompat
                app:key="daemon_enable"
                app:title="@string/daemon_enable" />

    </PreferenceCategory>

    <PreferenceCategory app:title="Updates">
        <Preference
                android:key="check_update"
                app:icon="@drawable/ic_system_update"
                android:title="Check for Updates"
                android:summary="Check GitHub for latest InvernessLoader build"/>
    </PreferenceCategory>

</PreferenceScreen>
